DATABASE_URL=file:./dev.db
BETTER_AUTH_SECRET="randomly-generated-str"
BETTER_AUTH_URL=http://localhost:3000
EMAIL_HOST=smtp.gmail.com
EMAIL_USER="sample-user@gmail.com"
EMAIL_PASS="google-app-pwd"
EMAIL_FROM="sample-user@gmail.com"
UPLOAD_STORAGE_PATH="full-path-to-image-store"
# Optional: LLM skill tie-break (off unless SKILL_TIEBREAK_PROVIDER=gemini)
SKILL_TIEBREAK_PROVIDER=tfidf
GEMINI_API_KEY=
# gemini-2.5-flash was retired by Google in Oct 2026; use a current model. Test it with ⚙ → Test Gemini.
GEMINI_MODEL=gemini-3.5-flash
